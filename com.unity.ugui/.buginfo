default:
  area: uGUI Controls

ugui-framework:
  when:
    path:
      - ^*Canvas.*$
      - ^*CanvasRenderer.*$
      - ^*Clipping.*$
      - ^*UnityEvent.*$
      - ^*EventSystem.*$
      - ^*Vertex.*$
  area: uGUI Framework

tmp-samples:
  when:
    path:
      - ^Samples~/.*$
  area: Text (TextMeshPro)
